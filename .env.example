# LLM providers. Supply only the provider(s) you intend to use.
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
GLM_API_KEY=CHANGE_ME
GLM_API_URL=CHANGE_ME
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local and backing services.
OLLAMA_BASE_URL=http://localhost:11434
SHORT_TERM_MEMORY_REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql+psycopg://metro_agent:CHANGE_ME@localhost:5432/metro_agent
AUTH_DATABASE_URL=mysql+pymysql://metro_auth:CHANGE_ME@localhost:3306/metro_auth
AUTH_SESSION_PEPPER=CHANGE_ME
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
WIREMOCK_BASE_URL=http://localhost:8080

# Optional offline evaluation configuration.
EVAL_JUDGE_MODEL=qwen3.7-max
EVAL_JUDGE_BASE_URL=CHANGE_ME
EVAL_JUDGE_TEMPERATURE=0
EVAL_JUDGE_TIMEOUT_SECONDS=60
EVAL_JUDGE_MAX_RETRIES=1
EVAL_JUDGE_EMBEDDING_MODEL=CHANGE_ME
RAG_SIMILARITY_CUTOFF=0.2

