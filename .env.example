# 内部试点部署秘密。以下四项必须填写；空值会让 docker compose 立即失败。
# 请为三个数据库密码生成独立的高熵、URL 安全值，严禁提交真实值。
POSTGRES_PASSWORD=
AUTH_MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 至少 32 字节随机值，仅用于会话令牌摘要；丢失后现有会话全部失效。
AUTH_SESSION_PEPPER=

# 本机 HTTP 调试使用 false；正式 HTTPS 部署必须改为 true。
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
# 可填完整镜像名、tag 或 digest，例如 registry.example/metro-agent@sha256:...
METRO_AGENT_IMAGE=metro-agent:local

# 知识库运行环境。production 时禁止启用确定性 E2E embedding。
METRO_AGENT_ENV=development
# 知识运行时只能通过 HTTP 访问 Chroma；默认地址为 chroma:8000。
CHROMA_HOST=chroma
CHROMA_PORT=8000
# 仅 knowledge-indexer 使用知识源；留空时当前运行时不配置知识源目录。
KNOWLEDGE_PATH=
# 发布校验 artifact 的根目录；留空时当前运行时不配置 artifact 目录。
KNOWLEDGE_ARTIFACT_ROOT=
# 仅确定性端到端测试 profile 可设为 1；production 环境拒绝该值。
KNOWLEDGE_E2E=0
# Chroma 服务的数据目录；仅 Chroma 容器应读写该目录。
CHROMA_DB_DIR=

# 宿主机模型根目录，目录内必须包含 bge-m3/ 和 bge-reranker/；容器只读挂载。
# Windows 示例：D:/models；Linux 示例：/srv/metro-agent/models。
MODEL_DIR=

# LLM 提供商。只填写实际使用的提供商，不要提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GLM_API_KEY=
GLM_API_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Compose 内访问宿主机 Ollama；数据库、Redis 和 WireMock 地址由 compose.yml 注入。
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 可选离线评测配置。
EVAL_JUDGE_MODEL=qwen3.7-max
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_TEMPERATURE=0
EVAL_JUDGE_TIMEOUT_SECONDS=60
EVAL_JUDGE_MAX_RETRIES=1
EVAL_JUDGE_EMBEDDING_MODEL=
RAG_SIMILARITY_CUTOFF=0.2

